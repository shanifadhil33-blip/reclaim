NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tried first. Direct Gemini REST. Skip the whole provider when this is empty.
GEMINI_API_KEY=
# Optional comma-separated chain. Flash-Lite models have the larger free daily quota.
# Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite
GEMINI_MODELS=

# Tried second, for text and letters. Skipped for page images. Skip when empty.
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b
GROQ_MODEL=

# Last resort. Existing OpenRouter model chains are unchanged. Skip when empty.
OPENROUTER_API_KEY=
